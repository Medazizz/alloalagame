# ============================================================
#  Réglages d'Allo..Ala Jeux sur le serveur — copier en .env
# ============================================================

# Adresse du jeu sur le site : https://alloala.com/jeu/
BASE_PATH=/jeu/

# Port interne (nginx transmet vers ce port)
PORT=3010

# Mot de passe de l'interface admin (https://alloala.com/jeu/#admin)
# Laisser vide : install.sh en génère un automatiquement.
ADMIN_KEY=

# --- Envoi des codes par e-mail depuis la boîte mail du domaine ---
# Ces informations sont dans le panneau de votre hébergeur mail
# (rubrique « configurer un client mail / SMTP »).
SMTP_HOST=mail.alloala.com
SMTP_PORT=465
SMTP_USER=contact@alloala.com
SMTP_PASS=
MAIL_FROM=contact@alloala.com
MAIL_NAME=Allo..Ala Jeux

# Dossier des données (base de données + sauvegardes). Par défaut : ./data
# DATA_DIR=/var/lib/alloalagame
